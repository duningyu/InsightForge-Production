INSIGHTFORGE_APP_NAME=InsightForge
INSIGHTFORGE_APP_VERSION=3.0.0
INSIGHTFORGE_DATABASE_PATH=data/insightforge.sqlite3
INSIGHTFORGE_MAX_LOOP_ROUNDS=2
INSIGHTFORGE_DEFAULT_TOP_K=8
HOST=127.0.0.1
PORT=8000
# Strongly recommended for any internet-facing deployment. Set both or neither.
# INSIGHTFORGE_ACCESS_USERNAME=admin
# INSIGHTFORGE_ACCESS_PASSWORD=replace-with-a-long-random-password
# Remote model credentials are configured write-only in Settings and stored in
# the operating-system credential manager, not in this file.
