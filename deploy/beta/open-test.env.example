# Non-secret target settings ONLY. Not applied to any running deployment.
# Load after legacy environment defaults; do not layer an old daily-limit override afterwards.
# Bind this directory to persistent storage using the existing deployment mechanism.
INSIGHTFORGE_ACCOUNTS_ENABLED=true
INSIGHTFORGE_ACCOUNTS_DIR=/data/insightforge/accounts
INSIGHTFORGE_DAILY_USER_LIMITS_ENABLED=false
BETA_SESSION_COOKIE_SECURE=true
# HTTPS target, one application process. For loopback HTTP tests only, override
# BETA_SESSION_COOKIE_SECURE=false; never use that override for HTTPS release.
# Provider credentials stay in the existing external private mechanism (not here).
