# Railway Stage A safe variable template. Replace only CHANGE_ME values in Railway Variables.
# Do not commit provider keys, passwords, cookies, invites, or database contents.

PORT=CHANGE_ME_RAILWAY_INJECTED
HOST=0.0.0.0
INSIGHTFORGE_DATA_ROOT=/app/data
BETA_PARTICIPANT_ID=railway_stage_a
INSIGHTFORGE_APP_NAME=InsightForge
INSIGHTFORGE_APP_VERSION=CHANGE_ME_RELEASE_ID
INSIGHTFORGE_MAX_LOOP_ROUNDS=2
INSIGHTFORGE_DEFAULT_TOP_K=8

# Stage A keeps Search disabled and does not enable multi-user accounts.
INSIGHTFORGE_ACCOUNTS_ENABLED=false
INSIGHTFORGE_STRUCTURED_AI_MODE=CHANGE_ME_OPTIONAL
# Stage A only: deterministic, visibly labelled synthetic generation. Keep false
# or unset in beta and production; the app also requires the Stage A participant.
INSIGHTFORGE_SAFE_FIXTURE_MODE=false
INSIGHTFORGE_SAFE_FIXTURE_SCENARIO=success

# Set these only when a controlled edge is intentionally placed in front of the service.
INSIGHTFORGE_ACCESS_USERNAME=CHANGE_ME_OPTIONAL
INSIGHTFORGE_ACCESS_PASSWORD=CHANGE_ME_OPTIONAL

# Provider credentials, if enabled in a later task, belong only in Railway secret Variables.
# OPENAI_API_KEY=<set-in-railway>
# MANAGED_QWEN_API_KEY=<set-in-railway>
# MANAGED_BAILIAN_API_KEY=<set-in-railway>
